# Where Next proxies /api/v1 (server-side only; never exposed to the browser)
VIBEGUARD_API_URL=http://localhost:8000

# Firebase web config: Firebase console -> Project settings -> Your apps -> Web app.
# Copy to frontend/.env.local. These are public identifiers, not secrets; leave them all blank
# to run the dashboard without sign-in against the local devserver.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
