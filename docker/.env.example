# Read by docker compose for the `app` profile.
OPENROUTER_API_KEY=
LLM_MODEL="google/gemma-4-31b-it:free"
LLM_FALLBACK_MODEL="google/gemma-4-26b-a4b-it:free"
# Then these, in order, when Gemma is rate-limited (free models from other providers)
LLM_FALLBACK_MODELS=["nvidia/nemotron-3.5-super-vl:free","dots-studio/dots-3-note-preview:free"]
VIBEGUARD_GITHUB_TOKEN=
VIBEGUARD_GITHUB_WEBHOOK_SECRET=

# Firebase sign-in (Project settings -> Your apps -> Web app config). Web values are public.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Who may sign in, as JSON lists. Empty = nobody.
VIBEGUARD_AUTH_ALLOWED_EMAILS=["you@example.com"]
VIBEGUARD_AUTH_ALLOWED_DOMAINS=[]
# GitHub sign-ins, by numeric account id (https://api.github.com/users/<login> -> "id")
VIBEGUARD_AUTH_ALLOWED_GITHUB_IDS=[]
