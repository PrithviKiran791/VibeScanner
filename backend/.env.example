# Copy to backend/.env (gitignored) and fill in real values there, never in this file.
# Settings accept the VIBEGUARD_ prefix or, where noted, the bare name (see vibeguard/config.py).

# LLM pass: openrouter | gemini | none
VIBEGUARD_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=""
LLM_MODEL="google/gemma-4-31b-it:free"
LLM_BASE_URL="https://openrouter.ai/api/v1"
# Tried once if the primary model is rate-limited (429) or unavailable
LLM_FALLBACK_MODEL="google/gemma-4-26b-a4b-it:free"

VIBEGUARD_GEMINI_API_KEY=

# Limits
VIBEGUARD_MAX_REPO_BYTES=52428800
VIBEGUARD_SCAN_DEADLINE_S=55
VIBEGUARD_LLM_MAX_UNITS=40

# GitHub: private clones + "Apply Fix (PR)" (needs repo scope). CLI reads GITHUB_TOKEN.
VIBEGUARD_GITHUB_TOKEN=
# Webhook secret (repo webhook or GitHub App, "push" events, application/json). Unset = disabled.
VIBEGUARD_GITHUB_WEBHOOK_SECRET=

# Per-client limits on write endpoints (requests per minute); reads are never limited
VIBEGUARD_RATE_LIMIT_SCANS_PER_MINUTE=10
VIBEGUARD_RATE_LIMIT_PRS_PER_MINUTE=5
# Proxies whose X-Forwarded-For is trusted for client IPs (JSON list of IPs/CIDRs)
VIBEGUARD_TRUSTED_PROXIES=[]
GITHUB_TOKEN=
# Webhook secret (repo webhook or GitHub App, "push" events, application/json). Unset = disabled.
VIBEGUARD_GITHUB_WEBHOOK_SECRET=

# Per-client limits on write endpoints (requests per minute); reads are never limited
VIBEGUARD_RATE_LIMIT_SCANS_PER_MINUTE=10
VIBEGUARD_RATE_LIMIT_PRS_PER_MINUTE=5
# Proxies whose X-Forwarded-For is trusted for client IPs (JSON list of IPs/CIDRs)
VIBEGUARD_TRUSTED_PROXIES=[]
