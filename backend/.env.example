# Copy to backend/.env. All settings use the VIBEGUARD_ prefix (see vibeguard/config.py).

# LLM pass: anthropic | gemini | none
VIBEGUARD_LLM_PROVIDER=anthropic
# Optional. If unset, the Anthropic SDK falls back to ANTHROPIC_API_KEY or an `ant auth login` profile.
VIBEGUARD_ANTHROPIC_API_KEY=
# Model ID for the selected provider (alias: LLM_MODEL_ID). Blank = provider default
# (anthropic: claude-opus-5-5, gemini: gemini-2.5-flash).
VIBEGUARD_LLM_MODEL=
VIBEGUARD_ANTHROPIC_EFFORT=medium

VIBEGUARD_GEMINI_API_KEY=

# Limits
VIBEGUARD_MAX_REPO_BYTES=52428800
VIBEGUARD_SCAN_DEADLINE_S=55
VIBEGUARD_LLM_MAX_UNITS=40

# Private repo clones (CLI only)
GITHUB_TOKEN=
